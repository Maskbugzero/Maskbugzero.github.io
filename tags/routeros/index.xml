<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>RouterOS on Zero Day Notes</title><link>https://blog.5772447.xyz/tags/routeros/</link><description>Recent content in RouterOS on Zero Day Notes</description><generator>Hugo -- gohugo.io</generator><language>zh</language><lastBuildDate>Sat, 13 May 2023 09:32:11 +0000</lastBuildDate><atom:link href="https://blog.5772447.xyz/tags/routeros/index.xml" rel="self" type="application/rss+xml"/><item><title>MTK7621路由器刷Mikrotik rb750gr3固件</title><link>https://blog.5772447.xyz/posts/7c4a1a51/</link><pubDate>Sat, 13 May 2023 09:32:11 +0000</pubDate><guid>https://blog.5772447.xyz/posts/7c4a1a51/</guid><description>&lt;h2 id="前言"&gt;&lt;a href="#%e5%89%8d%e8%a8%80" class="header-anchor"&gt;&lt;/a&gt;前言&#13;&#10;&lt;/h2&gt;&lt;p&gt;将MTK7621路由器刷成Mikrotik RB750Gr3 的编程器固件&lt;/p&gt;&#10;&lt;h2 id="准备工作"&gt;&lt;a href="#%e5%87%86%e5%a4%87%e5%b7%a5%e4%bd%9c" class="header-anchor"&gt;&lt;/a&gt;准备工作&#13;&#10;&lt;/h2&gt;&lt;p&gt;1.搜索wr330或wr1200js，下单。&lt;/p&gt;&#10;&lt;p&gt;2.下载rb750gr3&lt;a class="link" href="https://download.zeuo.eu.org/routeros%e7%bc%96%e8%be%91%e5%99%a8%e5%9b%ba%e4%bb%b6.zip" target="_blank" rel="noopener"&#13;&#10; &gt;编程器固件&lt;/a&gt;&lt;/p&gt;&#10;&lt;p&gt;3.下载wr330的&lt;a class="link" href="https://breed.hackpascal.net/breed-mt7621-pbr-m1.bin" target="_blank" rel="noopener"&#13;&#10; &gt;breed文件&lt;/a&gt;&lt;/p&gt;&#10;&lt;h2 id="刷机"&gt;&lt;a href="#%e5%88%b7%e6%9c%ba" class="header-anchor"&gt;&lt;/a&gt;刷机&#13;&#10;&lt;/h2&gt;&lt;p&gt;wr330,加电状态下长按wp，恢复出厂设置。&lt;/p&gt;&#10;&lt;p&gt;登陆http://192.168.0.1，在管理页面，把账号 admin 改为 root ,密码Admin123并保存。&lt;/p&gt;&#10;&lt;p&gt;浏览器打开http://192.168.0.1/adm/telnetd.shtml 点Telnet后面的ON使其变成OFF。&lt;/p&gt;&#10;&lt;p&gt;打开cmd ，输入telnet 192.168.0.1  输账号root ，回车，输密码Admin123  回车。&lt;/p&gt;&#10;&lt;p&gt;找一个U盘并选FAT16格式化，把“breed-mt7621-pbr-m1.bin”复制到u盘根目录，然后插入wr330 usb口。&lt;/p&gt;&#10;&lt;p&gt;telnet下进入u盘根目录&lt;/p&gt;&#10;&lt;div class="highlight"&gt;&lt;div style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&#10;&lt;table style="border-spacing:0;padding:0;margin:0;border:0;"&gt;&lt;tr&gt;&lt;td style="vertical-align:top;padding:0;margin:0;border:0;"&gt;&#10;&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f"&gt;1&#10;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&#10;&lt;td style="vertical-align:top;padding:0;margin:0;border:0;;width:100%"&gt;&#10;&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-shell" data-lang="shell"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;cd /media/sda1&#10;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&#10;&lt;/div&gt;&#10;&lt;/div&gt;&lt;p&gt;备份原厂编程器固件&lt;/p&gt;&#10;&lt;div class="highlight"&gt;&lt;div style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&#10;&lt;table style="border-spacing:0;padding:0;margin:0;border:0;"&gt;&lt;tr&gt;&lt;td style="vertical-align:top;padding:0;margin:0;border:0;"&gt;&#10;&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f"&gt;1&#10;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&#10;&lt;td style="vertical-align:top;padding:0;margin:0;border:0;;width:100%"&gt;&#10;&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-shell" data-lang="shell"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;dd &lt;span style="color:#66d9ef"&gt;if&lt;/span&gt;&lt;span style="color:#f92672"&gt;=&lt;/span&gt;/dev/mtd0 of&lt;span style="color:#f92672"&gt;=&lt;/span&gt;wr330.bin&#10;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&#10;&lt;/div&gt;&#10;&lt;/div&gt;&lt;p&gt;刷入 breed&lt;/p&gt;&#10;&lt;div class="highlight"&gt;&lt;div style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&#10;&lt;table style="border-spacing:0;padding:0;margin:0;border:0;"&gt;&lt;tr&gt;&lt;td style="vertical-align:top;padding:0;margin:0;border:0;"&gt;&#10;&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f"&gt;1&#10;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&#10;&lt;td style="vertical-align:top;padding:0;margin:0;border:0;;width:100%"&gt;&#10;&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-shell" data-lang="shell"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;mtd_write write breed-mt7621-pbr-m1.bin Bootloader&#10;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&#10;&lt;/div&gt;&#10;&lt;/div&gt;&lt;p&gt;重启路由&lt;/p&gt;&#10;&lt;div class="highlight"&gt;&lt;div style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&#10;&lt;table style="border-spacing:0;padding:0;margin:0;border:0;"&gt;&lt;tr&gt;&lt;td style="vertical-align:top;padding:0;margin:0;border:0;"&gt;&#10;&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f"&gt;1&#10;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&#10;&lt;td style="vertical-align:top;padding:0;margin:0;border:0;;width:100%"&gt;&#10;&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-shell" data-lang="shell"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;reboot&#10;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&#10;&lt;/div&gt;&#10;&lt;/div&gt;&lt;p&gt;重启的同时，按住 WIFI 键进入 breed。&lt;/p&gt;&#10;&lt;p&gt;浏览器打开192.168.1.1进入breed，更新固件，选择编程器固件，去掉 “保留Bootlodert”和“保留eeprom”前面的勾，选择RB750GR3-new.bin，上传，更新。&lt;/p&gt;&#10;&lt;p&gt;静待一分钟，就进入routeros了。&lt;/p&gt;&#10;&lt;h2 id="授权"&gt;&lt;a href="#%e6%8e%88%e6%9d%83" class="header-anchor"&gt;&lt;/a&gt;授权&#13;&#10;&lt;/h2&gt;&lt;p&gt;&lt;a class="link" href="https://mikrotik.com/client" target="_blank" rel="noopener"&#13;&#10; &gt;https://mikrotik.com/client&lt;/a&gt; 注册并登录。&lt;/p&gt;&#10;&lt;p&gt;进入后台后，找到Make a demo key 填入Software ID（Software ID在进入ros管理页面时会跳出来），点击生成，就能得到一个L1的Key，粘贴到命令行或在Winbox的system下的License 处粘贴。&lt;/p&gt;&#10;&lt;h2 id="结束"&gt;&lt;a href="#%e7%bb%93%e6%9d%9f" class="header-anchor"&gt;&lt;/a&gt;结束&#13;&#10;&lt;/h2&gt;&lt;p&gt;45块包邮，mikrotik rb750gr3到手。&lt;/p&gt;&#10;&lt;h2 id="备注"&gt;&lt;a href="#%e5%a4%87%e6%b3%a8" class="header-anchor"&gt;&lt;/a&gt;备注&#13;&#10;&lt;/h2&gt;&lt;p&gt;中兴E8820S，改16M的SPI NOR闪存，移动板子后面两颗电阻位置，在防火墙设置里添加好fasttrack规则，电信千兆光纤基本可以跑满（注：需加强散热）；&#10;友华WR330，刷后很完美，在防火墙设置里添加好fasttrack规则，电信千兆光纤基本可以跑满（注：需加强散热）；&#10;中兴E8820 V2，虽然也是7621主控和16M SPI NOR闪存，但用编程器写了固件以后，WinBox无法搜索到；&#10;小米路由器PRO（R3P），改16M的SPI NOR闪存，用编程器写了固件以后，WinBox无法搜索到。&lt;/p&gt;&#10;&lt;p&gt;——————————————————————————————&#10;可刷这个固件的机型还有：&#10;newifi2  D1&#10;斐讯k2p（A1 A2）&#10;BLINK W1200&#10;bufullo wsr-1166dhp&#10;toto-link a3004ns&#10;友华 wr1200js&lt;/p&gt;&#10;&lt;p&gt;——————————————————————————————&lt;/p&gt;&#10;</description></item><item><title>自用RouterOS系统设置命令</title><link>https://blog.5772447.xyz/posts/c3837b48/</link><pubDate>Tue, 21 Mar 2023 17:43:05 +0000</pubDate><guid>https://blog.5772447.xyz/posts/c3837b48/</guid><description>&lt;h2 id="前言"&gt;&lt;a href="#%e5%89%8d%e8%a8%80" class="header-anchor"&gt;&lt;/a&gt;前言&#13;&#10;&lt;/h2&gt;&lt;p&gt;自用RouterOS系统设置命令，包括DoH证书以及常用防火墙设置。&lt;/p&gt;&#10;&lt;h2 id="dns设置"&gt;&lt;a href="#dns%e8%ae%be%e7%bd%ae" class="header-anchor"&gt;&lt;/a&gt;DNS设置&#13;&#10;&lt;/h2&gt;&lt;p&gt;使用阿里云DoH Dns地址 &lt;code&gt;https://dns.alidns.com/dns-query&lt;/code&gt;&lt;/p&gt;&#10;&lt;h3 id="证书导入"&gt;&lt;a href="#%e8%af%81%e4%b9%a6%e5%af%bc%e5%85%a5" class="header-anchor"&gt;&lt;/a&gt;证书导入&#13;&#10;&lt;/h3&gt;&lt;p&gt;以下是证书导入代码&lt;/p&gt;&#10;&lt;div class="highlight"&gt;&lt;div style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&#10;&lt;table style="border-spacing:0;padding:0;margin:0;border:0;"&gt;&lt;tr&gt;&lt;td style="vertical-align:top;padding:0;margin:0;border:0;"&gt;&#10;&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f"&gt;1&#10;&lt;/span&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f"&gt;2&#10;&lt;/span&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f"&gt;3&#10;&lt;/span&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f"&gt;4&#10;&lt;/span&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f"&gt;5&#10;&lt;/span&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f"&gt;6&#10;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&#10;&lt;td style="vertical-align:top;padding:0;margin:0;border:0;;width:100%"&gt;&#10;&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-shell" data-lang="shell"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;/tool fetch url&lt;span style="color:#f92672"&gt;=&lt;/span&gt;&lt;span style="color:#e6db74"&gt;&amp;#34;https://secure.globalsign.net/cacert/Root-R5.crt&amp;#34;&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;/tool fetch url&lt;span style="color:#f92672"&gt;=&lt;/span&gt;&lt;span style="color:#e6db74"&gt;&amp;#34;https://secure.globalsign.com/cacert/gseccovsslca2018.crt&amp;#34;&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;/certificate import file-name&lt;span style="color:#f92672"&gt;=&lt;/span&gt;Root-R5.crt&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;/certificate import file-name&lt;span style="color:#f92672"&gt;=&lt;/span&gt;gseccovsslca2018.crt&#10;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&#10;&lt;/div&gt;&#10;&lt;/div&gt;&lt;h3 id="静态地址解析"&gt;&lt;a href="#%e9%9d%99%e6%80%81%e5%9c%b0%e5%9d%80%e8%a7%a3%e6%9e%90" class="header-anchor"&gt;&lt;/a&gt;静态地址解析&#13;&#10;&lt;/h3&gt;&lt;p&gt;RouterOS.Lan&lt;/p&gt;&#10;&lt;ul&gt;&#10;&lt